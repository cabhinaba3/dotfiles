# ~/.bashrc.local -- machine-local, NEVER committed to this repo.
#
# The managed block in ~/.bashrc sources this file if it exists, so it's
# the right place for anything that's either a secret or specific to one
# machine: API keys, one-off PATH entries, work-only aliases.
#
# Copy this file to ~/.bashrc.local and fill in what you need:
#
#   cp bash/local.env.example ~/.bashrc.local
#
# Example contents (uncomment / edit as needed):

# export GEMINI_API_KEY="your-key-here"
# export OPENAI_API_KEY="your-key-here"
# export AWS_PROFILE="work"

# Antigravity IDE, if installed to ~/Downloads (machine-specific location):
# [ -x "$HOME/Downloads/Antigravity-x64/antigravity" ] && \
#     alias antigravity="$HOME/Downloads/Antigravity-x64/antigravity"
