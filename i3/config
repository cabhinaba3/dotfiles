# i3 config file (v4)
# Minimal, emoji-free configuration inspired by ecnerwala/dotfiles

set $mod Mod4
set $alt Mod1

# Font for window titles. Using a standard monospace font.
font pango:JetBrainsMono Nerd Font 7

for_window [class=".*"] title_window_icon on

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# start a terminal (alacritty is chosen)
bindsym $mod+Return exec alacritty

# kill focused window
bindsym $mod+q kill

# start dmenu (a program launcher)
bindsym $mod+space exec --no-startup-id j4-dmenu-desktop --no-generic --display-binary

# change focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+H move left
bindsym $mod+Shift+J move down
bindsym $mod+Shift+K move up
bindsym $mod+Shift+L move right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# split next window horizontally / vertically
bindsym $mod+b split h
bindsym $mod+v split v

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# focus the parent container
bindsym $mod+a focus parent

# focus the child container
bindsym $mod+n focus child

# switch to workspace
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Tab workspace next_on_output
bindsym $mod+Shift+Tab workspace prev_on_output
bindsym $alt+Tab focus output right

# move focused container to workspace
bindsym $mod+Shift+exclam move container to workspace number 1
bindsym $mod+Shift+at move container to workspace number 2
bindsym $mod+Shift+numbersign move container to workspace number 3
bindsym $mod+Shift+dollar move container to workspace number 4
bindsym $mod+Shift+percent move container to workspace number 5
bindsym $mod+Shift+asciicircum move container to workspace number 6
bindsym $mod+Shift+ampersand move container to workspace number 7
bindsym $mod+Shift+asterisk move container to workspace number 8
bindsym $mod+Shift+parenleft move container to workspace number 9
bindsym $mod+Shift+parenright move container to workspace number 10

# reload the configuration file
bindsym $mod+Shift+C reload
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+R restart
# exit i3 (logs you out of your X session)
bindsym $mod+Shift+E exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -b 'Yes, exit i3' 'i3-msg exit'"

# lock screen
bindsym $mod+Pause exec --no-startup-id i3lock -c 202020 && xset dpms force off

# resize window (you can also use the mouse for that)
mode "resize" {
	bindsym h resize shrink width 10 px or 10 ppt
	bindsym j resize grow height 10 px or 10 ppt
	bindsym k resize shrink height 10 px or 10 ppt
	bindsym l resize grow width 10 px or 10 ppt
	bindsym Shift+H resize shrink width 1 px or 1 ppt
	bindsym Shift+J resize grow height 1 px or 1 ppt
	bindsym Shift+K resize shrink height 1 px or 1 ppt
	bindsym Shift+L resize grow width 1 px or 1 ppt

	bindsym Left resize shrink width 10 px or 10 ppt
	bindsym Down resize grow height 10 px or 10 ppt
	bindsym Up resize shrink height 10 px or 10 ppt
	bindsym Right resize grow width 10 px or 10 ppt
	bindsym Shift+Left resize shrink width 1 px or 1 ppt
	bindsym Shift+Down resize grow height 1 px or 1 ppt
	bindsym Shift+Up resize shrink height 1 px or 1 ppt
	bindsym Shift+Right resize grow width 1 px or 1 ppt

	bindsym Return mode "default"
	bindsym Escape mode "default"
}

bindsym $mod+r mode "resize"

# Mark support
bindsym $mod+m exec --no-startup-id i3-input -F 'mark %s' -l 1 -P 'Mark: '
bindsym $mod+Shift+M exec --no-startup-id i3-input -F 'mark %s' -P 'Mark: '
bindsym $mod+Ctrl+m exec --no-startup-id i3-input -F 'unmark %s' -P 'Unmark: '
bindsym $mod+apostrophe exec --no-startup-id i3-input -F '[con_mark="%s"] focus' -l 1 -P 'Go to: '
bindsym $mod+Shift+quotedbl exec --no-startup-id i3-input -F '[con_mark="%s"] focus' -P 'Go to: '

# dunst support
bindsym $mod+period exec --no-startup-id dunstctl close
bindsym $mod+Ctrl+period exec --no-startup-id dunstctl close-all
bindsym $mod+comma exec --no-startup-id dunstctl history-pop
bindsym $mod+Shift+period exec --no-startup-id dunstctl context

# Nord Theme Colors
set $bg #2E3440
set $bg_inactive #3B4252
set $border #4C566A
set $border_active #81A1C1
set $text #D8DEE9
set $text_inactive #D8DEE9
set $urgent #BF616A

# clientclass           border         backgr.      text           indicator      child_border
client.focused          $border_active $bg          $text          $border_active $border_active
client.focused_inactive $border        $bg_inactive $text_inactive $border        $border
client.unfocused        $border        $bg_inactive $text_inactive $border        $border
client.urgent           $urgent        $urgent      $bg            $urgent        $urgent

# Status bar (Nord themed, minimal)
bar {
	font pango:JetBrainsMono Nerd Font 9
	status_command i3status --config ~/.config/i3status/config
	position bottom
	tray_output primary

	colors {
		background #2E3440
		statusline #D8DEE9
		separator  #4C566A

		focused_workspace  #81A1C1 #81A1C1 #2E3440
		active_workspace   #4C566A #4C566A #D8DEE9
		inactive_workspace #2E3440 #2E3440 #4C566A
		urgent_workspace   #BF616A #BF616A #ECEFF4
	}
}

# Import DISPLAY/XAUTHORITY into the systemd --user and D-Bus activation
# environment. Without this, D-Bus-activated services (e.g. dunst, started
# on-demand when something sends a desktop notification) fail with
# "Cannot open X11 display" because they never see DISPLAY.
exec --no-startup-id dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_SESSION_TYPE

# Compositor (picom)
exec_always --no-startup-id bash -c "killall -q picom; picom --config ~/.config/picom/picom.conf -b"

# Set video wallpaper
exec_always --no-startup-id ~/.config/i3/set_wallpaper.sh

# Autostart Alacritty instances across monitors
exec --no-startup-id ~/.config/i3/launch_alacritty_monitors.sh

# Set Dracula cursor theme (via xrdb and xsetroot)
exec_always --no-startup-id xrdb -merge ~/.Xresources
exec_always --no-startup-id xsetroot -cursor_name left_ptr

# System tray applets: network (wifi) and bluetooth icons in the bar
# (bar has tray_output primary set above, so these render there)
exec --no-startup-id nm-applet
exec --no-startup-id blueman-applet

# Audio controls
bindsym XF86AudioRaiseVolume exec --no-startup-id pamixer -i 5
bindsym XF86AudioLowerVolume exec --no-startup-id pamixer -d 5
bindsym XF86AudioMute exec --no-startup-id pamixer -t

# Brightness controls
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +5%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-
